model HbmsConversation {
  id           String                   @id @default(uuid())
  kind         HbmsConversationKind
  departmentId String?                  @unique
  department   Department?              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  projectId    String?                  @unique
  project      HbmsProject?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    Employee?                @relation("ProjectGroupAdmin", fields: [createdById], references: [id], onDelete: SetNull)
  directKey    String?                  @unique
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  messages     HbmsConversationMessage[]
  members      HbmsConversationMember[]

  @@index([kind])
  @@index([createdById])
}

model HbmsConversationMember {
  id             String           @id @default(uuid())
  conversationId String
  conversation   HbmsConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId         Int?
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  lastDeliveredAt DateTime?
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, employeeId])
  @@unique([conversationId, userId])
  @@index([employeeId])
  @@index([userId])
}

model HbmsConversationMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   HbmsConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         Employee?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorUserId   Int?
  authorUser     User?            @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  asDepartment   Boolean          @default(false)
  body           String
  replyToId      String?
  replyTo        HbmsConversationMessage?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        HbmsConversationMessage[] @relation("MessageReply")
  reactions      HbmsMessageReaction[]
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

model HbmsMessageReaction {
  id        String                  @id @default(uuid())
  messageId String
  message   HbmsConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime                @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model HbmsPushToken {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("unknown")
  updatedAt DateTime @updatedAt

  @@index([userId])
}

